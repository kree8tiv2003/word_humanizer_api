{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Load Qwen-Image-Edit 2509"},
    "inputs": {"unet_name": "qwen_image_edit_2509_fp8_e4m3fn.safetensors", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {"title": "Lightning 4-step LoRA"},
    "inputs": {"model": ["1", 0], "lora_name": "Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors", "strength_model": 1.0}
  },
  "3": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {"title": "Model Sampling (shift)"},
    "inputs": {"model": ["2", 0], "shift": 3.0}
  },
  "4": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Load Qwen2.5-VL text encoder"},
    "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default"}
  },
  "5": {
    "class_type": "VAELoader",
    "_meta": {"title": "Load Qwen-Image VAE"},
    "inputs": {"vae_name": "qwen_image_vae.safetensors"}
  },
  "6": {
    "class_type": "LoadImage",
    "_meta": {"title": "Your character image (front-facing portrait)"},
    "inputs": {"image": "character.png"}
  },
  "7": {
    "class_type": "ImageScaleToTotalPixels",
    "_meta": {"title": "Scale reference to ~1 MP"},
    "inputs": {"image": ["6", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 1}
  },
  "8": {
    "class_type": "LoadImage",
    "_meta": {"title": "Your character SHEET (optional second reference)"},
    "inputs": {"image": "character_sheet.png"}
  },
  "9": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": {"title": "Scene prompt (injected by make_video.py)"},
    "inputs": {"clip": ["4", 0], "vae": ["5", 0], "image1": ["7", 0], "image2": ["8", 0], "prompt": "Scene keyframe prompt is injected here"}
  },
  "10": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": {"title": "Negative"},
    "inputs": {"clip": ["4", 0], "vae": ["5", 0], "image1": ["7", 0], "image2": ["8", 0], "prompt": ""}
  },
  "11": {
    "class_type": "EmptySD3LatentImage",
    "_meta": {"title": "16:9 keyframe canvas"},
    "inputs": {"width": 1344, "height": 768, "batch_size": 1}
  },
  "12": {
    "class_type": "KSampler",
    "_meta": {"title": "KSampler"},
    "inputs": {
      "model": ["3", 0],
      "positive": ["9", 0],
      "negative": ["10", 0],
      "latent_image": ["11", 0],
      "seed": 777,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"},
    "inputs": {"samples": ["12", 0], "vae": ["5", 0]}
  },
  "14": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save keyframe"},
    "inputs": {"images": ["13", 0], "filename_prefix": "god_inside/keyframes/scene_A"}
  }
}
